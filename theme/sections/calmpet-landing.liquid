  #calmpet-landing .cp-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;background:linear-gradient(180deg,var(--cp-orange-light),var(--cp-orange));color:#fff;border:0;border-radius:14px;padding:17px 27px;text-decoration:none;font-weight:900;box-shadow:0 5px 0 #bd5100,0 12px 24px rgba(253,113,0,.18);cursor:pointer;transition:.2s} #calmpet-landing .cp-btn:hover{transform:translateY(-2px);box-shadow:0 7px 0 #bd5100,0 16px 28px rgba(253,113,0,.22)}
