lay:flex;flex-wrap:wrap;gap:8px;margin:20px 0} #calmpet-landing .cp-offer-usps span{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.22);border-radius:999px;padding:7px 11px;font-size:.73rem;font-weight:800}
