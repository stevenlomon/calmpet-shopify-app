{%- comment -%} ═══════════════════════════════════════════════════════════
  CALMPET LANDING PAGE — single-section, code-first
  Source: mockup.html + CalmPet Brand & UI Guidelines v1.0
═══════════════════════════════════════════════════════════ {%- endcomment -%}

{%- assign product_handle = section.settings.product | default: settings.lp_product -%}
{%- assign product = all_products[product_handle] -%}
{%- assign variant_one = product.variants.first -%}
{%- assign variant_five = product.variants[1] | default: product.variants.first -%}
{%- assign variant_eight = product.variants[2] | default: product.variants.last -%}
{%- assign hero_image = section.settings.hero_image | default: product.images[2] | default: product.featured_image -%}
{%- assign lifestyle_image = section.settings.lifestyle_image | default: product.images[1] | default: product.featured_image -%}
{%- assign product_image = section.settings.product_image | default: product.featured_image -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Nunito+Sans:opsz,wght@6..12,400;6..12,500;6..12,600;6..12,700;6..12,800;6..12,900&display=swap" rel="stylesheet">

<style>
  /* ═══ BRAND TOKENS (v1.0 guidelines) ═══ */
  #calmpet-landing{--cp-orange:#FD7100;--cp-orange-hover:#FF8420;--cp-orange-active:#F56A00;--cp-brown:#482206;--cp-ink:#3B1C06;--cp-cream:#FFF6EA;--cp-cream-soft:#F7EAD8;--cp-paper:#FFFDF9;--cp-olive:#8B9565;--cp-olive-dark:#66704C;--cp-yellow:#FFD76A;--cp-border:#E8D8C3;--cp-muted:#765943;--cp-shadow:0 4px 14px rgba(59,28,6,.07);--cp-shadow-playful:0 3px 0 rgba(59,28,6,.14);--cp-font:"Fredoka",sans-serif;--cp-font-ui:"Nunito Sans",sans-serif;--cp-radius-button:14px;--cp-radius-card:18px;--cp-radius-large:22px;--cp-radius-pill:999px}

  /* ═══ BASE ═══ */
  #calmpet-landing{background:var(--cp-cream);color:var(--cp-ink);font-family:var(--cp-font-ui);font-size:16px;line-height:1.5;overflow-x:hidden}
  #calmpet-landing *{box-sizing:border-box}
  #calmpet-landing img{display:block;max-width:100%}
  #calmpet-landing a,#calmpet-landing button{font:inherit}
  #calmpet-landing .cp-wrap{width:min(1240px,calc(100% - 48px));margin:auto}
  #calmpet-landing .cp-narrow{width:min(800px,calc(100% - 48px));margin:auto}
  #calmpet-landing section{padding:96px 0}
  #calmpet-landing h1,#calmpet-landing h2,#calmpet-landing h3{font-family:var(--cp-font);font-weight:700;color:var(--cp-ink);letter-spacing:-.035em;line-height:1.05;margin:0}
  #calmpet-landing h1{font-size:clamp(56px,5.2vw,64px);line-height:1}
  #calmpet-landing h2{font-size:clamp(42px,4vw,48px);line-height:1.05}
  #calmpet-landing h3{font-size:22px;line-height:1.1}
  #calmpet-landing p{margin:0 0 16px}
  #calmpet-landing .cp-eyebrow{font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
  #calmpet-landing .cp-highlight{background:linear-gradient(transparent 66%,var(--cp-yellow) 0)}

  /* ═══ ICONS ═══ */
  #calmpet-landing .cp-icon{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}

  /* ═══ SHARED COMPONENTS ═══ */
  #calmpet-landing .cp-social-proof{display:flex;align-items:center;gap:13px;margin-bottom:20px;font-size:14px;font-weight:800}
  #calmpet-landing .cp-stars{color:var(--cp-orange);letter-spacing:1.5px}
  #calmpet-landing .cp-divider{width:1px;height:20px;background:var(--cp-border)}
  #calmpet-landing .cp-section-head{text-align:center;max-width:780px;margin:0 auto 48px}
  #calmpet-landing .cp-section-head h2:after{content:"";display:block;width:76px;height:5px;background:var(--cp-orange);border-radius:var(--cp-radius-pill);margin:16px auto 0;transform:rotate(-2deg)}
  #calmpet-landing .cp-section-head p{font-size:17px;color:var(--cp-muted);margin-top:16px}
  #calmpet-landing .cp-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:56px;background:var(--cp-orange);color:#fff;border:1.5px solid var(--cp-ink);border-radius:var(--cp-radius-button);padding:16px 24px;text-decoration:none;font-weight:900;box-shadow:var(--cp-shadow-playful);cursor:pointer;transition:.2s}
  #calmpet-landing .cp-btn:hover{background:var(--cp-orange-hover);transform:translateY(-1px)}
  #calmpet-landing .cp-btn:active{background:var(--cp-orange-active)}
  #calmpet-landing .cp-subnote{font-size:12px;font-weight:700;color:var(--cp-muted);margin-top:12px}
  #calmpet-landing .cp-media-placeholder{display:grid;place-items:center;background:var(--cp-cream-soft);color:var(--cp-muted);font-size:13px;font-weight:900;letter-spacing:.1em;text-align:center;padding:20px}

  /* ═══ HIDE DAWN HEADER ═══ */
  .shopify-section-group-header-group{display:none!important}

  /* ═══ TOPBAR ═══ */
  #calmpet-landing .cp-topbar{background:var(--cp-brown);color:#fff;text-align:center;padding:10px 18px;font-size:12px;font-weight:800;letter-spacing:.065em}

  /* ═══ NAV ═══ */
  #calmpet-landing .cp-nav{height:76px;display:flex;align-items:center;justify-content:space-between}
  #calmpet-landing .cp-nav .cp-wrap{display:flex;align-items:center;justify-content:space-between}
  #calmpet-landing .cp-logo{width:164px;max-width:164px;height:auto;display:block}
  #calmpet-landing .cp-nav a:first-child{flex:0 0 auto;line-height:0}
  #calmpet-landing .cp-nav-links{display:flex;gap:28px;align-items:center}
  #calmpet-landing .cp-nav-links a{color:var(--cp-ink);font:800 15px/1 var(--cp-font-ui);text-decoration:none}
  #calmpet-landing .cp-nav-links a:hover{color:var(--cp-orange)}
  #calmpet-landing .cp-mini-cta{border:1.5px solid var(--cp-ink);border-radius:var(--cp-radius-pill);padding:11px 22px;font:800 15px/1 var(--cp-font-ui)}
  #calmpet-landing .cp-mini-cta:hover{background:var(--cp-orange);color:#fff;border-color:var(--cp-orange)}

  /* ═══ HERO ═══ */
  #calmpet-landing .cp-hero{padding:32px 0 80px}
  #calmpet-landing .cp-hero-grid{display:grid;grid-template-columns:1.04fr .96fr;gap:64px;align-items:center}
  #calmpet-landing .cp-hero h1 em{font-style:normal;color:var(--cp-orange)}
  #calmpet-landing .cp-dek{font-size:clamp(16px,1.5vw,18px);line-height:1.55;max-width:640px;margin:24px 0}
  #calmpet-landing .cp-checks{display:grid;gap:8px;list-style:none;padding:0;margin:0 0 28px}
  #calmpet-landing .cp-checks li{display:flex;gap:10px;align-items:center;font-weight:700}
  #calmpet-landing .cp-check{width:24px;height:24px;display:grid;place-items:center;border-radius:50%;background:var(--cp-yellow);font-size:13px;flex:0 0 auto}
  #calmpet-landing .cp-hero-photo{position:relative}
  #calmpet-landing .cp-hero-photo img{width:100%;height:608px;object-fit:cover;border:2px solid var(--cp-brown);border-radius:var(--cp-radius-large);box-shadow:var(--cp-shadow-playful)}
  #calmpet-landing .cp-photo-note{position:absolute;left:-16px;bottom:24px;background:var(--cp-paper);border:1.5px solid var(--cp-brown);border-radius:14px;padding:12px 16px;font-size:13px;font-weight:900;box-shadow:var(--cp-shadow-playful)}
  #calmpet-landing .cp-paw{position:absolute;right:-16px;top:36px;width:60px;height:60px;border-radius:50%;background:var(--cp-yellow);border:1.5px solid var(--cp-ink);display:grid;place-items:center;transform:rotate(9deg)}
  #calmpet-landing .cp-paw .cp-icon{width:32px;height:32px}

  /* ═══ MARQUEE ═══ */
  #calmpet-landing .cp-marquee{background:var(--cp-paper);border-block:1px solid var(--cp-border);overflow:hidden;padding:16px 0}
  #calmpet-landing .cp-marquee-track{display:flex;width:max-content;animation:cp-roll 28s linear infinite}
  #calmpet-landing .cp-marquee-set{display:flex;align-items:center}
  #calmpet-landing .cp-marquee-item{white-space:nowrap;font-size:14px;font-weight:800;margin-right:48px}
  #calmpet-landing .cp-marquee-item i{font-style:normal;display:inline-grid;place-items:center;width:32px;height:32px;margin-right:8px;border-radius:50%;background:var(--cp-yellow);color:var(--cp-ink)}
  #calmpet-landing .cp-marquee-item .cp-icon{width:18px;height:18px}
  @keyframes cp-roll{to{transform:translateX(-50%)}}

  /* ═══ EARLY PROOF ═══ */
  #calmpet-landing .cp-proof{background:var(--cp-paper);padding:80px 0}
  #calmpet-landing .cp-proof-intro{display:block;text-align:center;max-width:820px;margin:0 auto 34px}
  #calmpet-landing .cp-proof-intro .cp-social-proof{justify-content:center;margin:0 0 14px}
  #calmpet-landing .cp-proof-row{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  #calmpet-landing .cp-proof-card{background:var(--cp-cream);border:1.5px solid var(--cp-ink);border-radius:var(--cp-radius-card);overflow:hidden;box-shadow:var(--cp-shadow)}
  #calmpet-landing .cp-proof-photo{height:144px;background:var(--cp-cream-soft);display:grid;place-items:center;text-align:center;color:var(--cp-olive-dark);font-size:11px;font-weight:900;letter-spacing:.08em}
  #calmpet-landing .cp-proof-photo .cp-icon{width:34px;height:34px}
  #calmpet-landing .cp-proof-body{padding:20px}
  #calmpet-landing .cp-proof-body h3{font-size:20px;margin:8px 0}
  #calmpet-landing .cp-proof-body p{font-size:13px;color:var(--cp-muted)}
  #calmpet-landing .cp-proof-body small{font-size:12px;font-weight:700;color:var(--cp-muted)}

  /* ═══ PROBLEM ═══ */
  #calmpet-landing .cp-split{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}
  #calmpet-landing .cp-problem h2{margin-bottom:22px}
  #calmpet-landing .cp-problem h2+p{font-weight:700}
  #calmpet-landing .cp-scene-stack{display:grid;gap:12px;margin-top:28px}
  #calmpet-landing .cp-scene-row{display:flex;gap:16px;align-items:flex-start;background:var(--cp-paper);border:1px solid var(--cp-border);border-radius:14px;padding:16px}
  #calmpet-landing .cp-scene-row i{width:48px;height:48px;display:grid;place-items:center;border-radius:12px;background:var(--cp-yellow);flex:0 0 auto}
  #calmpet-landing .cp-scene-row .cp-icon{width:24px;height:24px}
  #calmpet-landing .cp-scene-row b{display:block}
  #calmpet-landing .cp-scene-row span{color:var(--cp-muted);font-size:14px}
  #calmpet-landing .cp-story-pull{margin-top:22px;padding:18px 20px;background:var(--cp-yellow);border:1.5px solid var(--cp-ink);border-radius:14px;font-weight:900}
  #calmpet-landing .cp-stat{background:var(--cp-brown);color:#fff;border-radius:var(--cp-radius-large);padding:48px;box-shadow:var(--cp-shadow-playful);border:1.5px solid var(--cp-ink);position:relative;overflow:hidden}
  #calmpet-landing .cp-stat:before{content:"";position:absolute;left:0;top:0;bottom:0;width:8px;background:var(--cp-orange)}
  #calmpet-landing .cp-stat:after{content:"";position:absolute;width:300px;height:300px;border:32px solid rgba(255,255,255,.08);border-radius:50%;right:-60px;top:-80px;pointer-events:none}
  #calmpet-landing .cp-stat-number{font:700 clamp(64px,7vw,96px)/.86 var(--cp-font);color:var(--cp-yellow);position:relative;letter-spacing:-.035em}
  #calmpet-landing .cp-stat-number span{display:block;font-size:.52em;letter-spacing:-.02em;margin-bottom:8px}
  #calmpet-landing .cp-stat-number small{display:block;font:700 .3em/1 var(--cp-font);letter-spacing:.08em;margin-top:12px}
  #calmpet-landing .cp-stat-claim{font-size:19px;line-height:1.4;margin:22px 0 0}
  #calmpet-landing .cp-stat-detail{font-size:14px;line-height:1.5;margin:16px 0 0;color:#f6e6d9}
  #calmpet-landing .cp-stat-source{font-size:11px;color:#d9baa2;margin-top:20px}

  /* ═══ MECHANISM ═══ */
  #calmpet-landing .cp-mechanism{background:var(--cp-cream-soft)}
  #calmpet-landing .cp-mechanism p{max-width:590px}
  #calmpet-landing .cp-mechanism-name strong{color:var(--cp-orange)}
  #calmpet-landing .cp-mechanism-close{font-size:17px;line-height:1.55;margin-top:22px}
  #calmpet-landing .cp-mechanism-close strong{color:var(--cp-orange)}
  #calmpet-landing .cp-river-visual{margin:0;background:var(--cp-paper);border:1.5px solid var(--cp-ink);border-radius:var(--cp-radius-large);overflow:hidden;box-shadow:var(--cp-shadow-playful)}
  #calmpet-landing .cp-river-visual img{width:100%;aspect-ratio:3/2;object-fit:cover}
  #calmpet-landing .cp-river-stages{display:grid;grid-template-columns:repeat(3,1fr);background:var(--cp-paper)}
  #calmpet-landing .cp-river-stages div{padding:14px 12px;text-align:center;border-top:1px solid var(--cp-border);font-size:12px;font-weight:900}
  #calmpet-landing .cp-river-stages div+div{border-left:1px solid var(--cp-border)}
  #calmpet-landing .cp-river-stages b{display:block;color:var(--cp-orange);font-family:var(--cp-font);font-size:15px;margin-bottom:2px}
  #calmpet-landing .cp-mechanism-evidence{display:grid;grid-template-columns:auto 1fr;gap:18px;align-items:center;margin-top:34px;padding:22px 24px;background:var(--cp-brown);color:#fff;border:1.5px solid var(--cp-ink);border-radius:var(--cp-radius-card);box-shadow:var(--cp-shadow-playful)}
  #calmpet-landing .cp-evidence-number{min-width:112px;text-align:center;font:700 43px/1 var(--cp-font);color:var(--cp-yellow)}
  #calmpet-landing .cp-evidence-number small{display:block;font:800 11px var(--cp-font-ui);color:#f1dcca;letter-spacing:.08em;margin-top:6px}
  #calmpet-landing .cp-mechanism-evidence p{margin:0;font-size:15px}
  #calmpet-landing .cp-mechanism-evidence strong{color:var(--cp-yellow)}
  /* Fallback bucket when no image uploaded */
  #calmpet-landing .cp-bucket{background:var(--cp-paper);border:2px solid var(--cp-brown);border-radius:var(--cp-radius-large);padding:34px;box-shadow:var(--cp-shadow-playful)}
  #calmpet-landing .cp-bucket-stage{margin-bottom:22px}
  #calmpet-landing .cp-bucket-label{display:flex;justify-content:space-between;font-size:13px;font-weight:900;margin-bottom:7px}
  #calmpet-landing .cp-bank{height:64px;border:2px solid var(--cp-brown);background:#fff;border-radius:12px;overflow:hidden;position:relative}
  #calmpet-landing .cp-water{position:absolute;left:0;right:0;bottom:0;background:linear-gradient(90deg,var(--cp-orange),#ffa347);border-top:2px solid var(--cp-brown)}
  #calmpet-landing .cp-water-1{height:24%}
  #calmpet-landing .cp-water-2{height:55%}
  #calmpet-landing .cp-water-3{height:84%}

  /* ═══ FAILED TOOLS ═══ */
  #calmpet-landing .cp-failed{background:var(--cp-paper)}
  #calmpet-landing .cp-failed h2{margin-bottom:22px}
  #calmpet-landing .cp-attempt-list{display:flex;flex-wrap:wrap;gap:8px;list-style:none;padding:0;margin:0 0 22px}
  #calmpet-landing .cp-attempt-list li{display:inline-flex;align-items:center;gap:8px;background:var(--cp-cream);border:1px solid var(--cp-border);border-radius:var(--cp-radius-pill);padding:7px 12px 7px 8px;font-size:13px;font-weight:800}
  #calmpet-landing .cp-attempt-icon{width:29px;height:29px;display:grid;place-items:center;border-radius:50%;background:var(--cp-yellow);flex:0 0 auto}
  #calmpet-landing .cp-attempt-icon .cp-icon{width:16px;height:16px}
  #calmpet-landing .cp-failed-punch{font-weight:900}
  #calmpet-landing .cp-failed-close{font-size:17px;font-weight:700;margin-top:22px}
  #calmpet-landing .cp-failed-visual{position:relative;margin:0;border:1.5px solid var(--cp-ink);border-radius:var(--cp-radius-large);overflow:hidden;box-shadow:var(--cp-shadow-playful)}
  #calmpet-landing .cp-failed-visual img{width:100%;min-height:560px;object-fit:cover}
  #calmpet-landing .cp-failed-visual figcaption{position:absolute;left:20px;right:20px;bottom:20px;background:rgba(255,253,249,.94);border:1.5px solid var(--cp-ink);border-radius:14px;padding:14px 16px;font-weight:900}
  #calmpet-landing .cp-failed-placeholder{min-height:420px;border:2px dashed var(--cp-olive);border-radius:var(--cp-radius-large);background:var(--cp-cream-soft);display:grid;place-items:center;text-align:center;color:var(--cp-muted);font-weight:800}

  /* ═══ PRODUCT REVEAL ═══ */
  #calmpet-landing .cp-product{background:var(--cp-brown);color:#fff}
  #calmpet-landing .cp-product-stage{position:relative;background:var(--cp-cream);border-radius:var(--cp-radius-large);min-height:560px;display:grid;place-items:center;overflow:hidden;border:1.5px solid var(--cp-ink)}
  #calmpet-landing .cp-product-stage:before{content:"";position:absolute;width:440px;height:440px;border-radius:50%;background:var(--cp-yellow);opacity:.55}
  #calmpet-landing .cp-product-stage>img{width:88%;position:relative;filter:drop-shadow(0 20px 16px rgba(72,34,6,.18))}
  #calmpet-landing .cp-product-stage .cp-product-logo{position:absolute;left:24px;top:20px;width:120px;z-index:2}
  #calmpet-landing .cp-round-badge{position:absolute;right:24px;top:24px;width:96px;height:96px;border-radius:50%;background:var(--cp-orange);color:#fff;border:2px solid var(--cp-brown);display:grid;place-items:center;text-align:center;font:700 14px/1.15 var(--cp-font);transform:rotate(7deg);box-shadow:var(--cp-shadow-playful)}
  #calmpet-landing .cp-product-copy h2{font-size:clamp(40px,4vw,54px);line-height:1.04;margin-bottom:26px;color:#fff}
  #calmpet-landing .cp-product-copy p{color:#f1dcca;font-size:16px;line-height:1.62;margin-bottom:15px}
  #calmpet-landing .cp-product-copy p strong{color:#fff}
  #calmpet-landing .cp-product-highlight{color:var(--cp-yellow)}
  #calmpet-landing .cp-signal{background:var(--cp-yellow);color:var(--cp-ink);border:1.5px solid var(--cp-ink);border-radius:14px;padding:17px 18px;margin:22px 0 24px;box-shadow:0 3px 0 var(--cp-orange)}
  #calmpet-landing .cp-signal small{display:block;font-size:11px;font-weight:900;letter-spacing:.12em;margin-bottom:3px}
  #calmpet-landing .cp-signal strong{display:block;font-family:var(--cp-font);font-size:clamp(19px,2vw,25px);line-height:1.15}
  #calmpet-landing .cp-features{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:22px 0 26px}
  #calmpet-landing .cp-feature{position:relative;padding:12px 14px 12px 39px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);border-radius:12px;font-size:14px;font-weight:800}
  #calmpet-landing .cp-feature:before{content:"✓";position:absolute;left:14px;top:50%;transform:translateY(-50%);width:18px;height:18px;display:grid;place-items:center;border-radius:50%;background:var(--cp-yellow);color:var(--cp-ink);font-size:11px;font-weight:900}
  #calmpet-landing .cp-product .cp-subnote{color:#e8cdb7;font-size:12px}

  /* ═══ HOW TO USE ═══ */
  #calmpet-landing .cp-how{background:var(--cp-cream)}
  #calmpet-landing .cp-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
  #calmpet-landing .cp-step{display:flex;flex-direction:column;background:var(--cp-paper);border:1.5px solid var(--cp-ink);border-radius:var(--cp-radius-card);overflow:hidden;box-shadow:var(--cp-shadow-playful)}
  #calmpet-landing .cp-step-visual{height:184px;background:var(--cp-cream-soft);display:flex;flex-direction:column;gap:4px;justify-content:center;align-items:center;text-align:center;color:var(--cp-muted);font-size:11px;font-weight:900;letter-spacing:.13em;border-bottom:1px solid var(--cp-border)}
  #calmpet-landing .cp-step-visual:before{content:"";width:56px;height:56px;border-radius:50%;background:var(--cp-yellow);border:1.5px solid var(--cp-ink);margin-bottom:8px}
  #calmpet-landing .cp-step-body{flex:1;padding:22px 20px 24px}
  #calmpet-landing .cp-step-num{font-size:12px;font-weight:900;letter-spacing:.12em;color:var(--cp-orange)}
  #calmpet-landing .cp-step h3{font-size:23px;margin:8px 0}
  #calmpet-landing .cp-step p{font-size:14px;line-height:1.52;color:var(--cp-muted);margin:0}

  /* ═══ STORIES CAROUSEL ═══ */
  #calmpet-landing .cp-stories{background:var(--cp-cream-soft)}
  #calmpet-landing .cp-story-track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:18px;padding:4px 2px 16px;scrollbar-width:none}
  #calmpet-landing .cp-story-track::-webkit-scrollbar{display:none}
  #calmpet-landing .cp-story-slide{flex:0 0 100%;scroll-snap-align:start;display:grid;grid-template-columns:.8fr 1.2fr;gap:32px;align-items:center;background:var(--cp-paper);border:1.5px solid var(--cp-ink);border-radius:var(--cp-radius-large);box-shadow:var(--cp-shadow);padding:28px;opacity:.62;transform:scale(.985);transition:opacity .28s ease,transform .28s ease}
  #calmpet-landing .cp-story-slide.is-active{opacity:1;transform:scale(1)}
  #calmpet-landing .cp-story-photo{min-height:350px;border:1.5px dashed var(--cp-olive-dark);border-radius:var(--cp-radius-card);background:var(--cp-cream-soft);display:grid;place-items:center;text-align:center;color:var(--cp-olive-dark);font-size:12px;font-weight:900;letter-spacing:.08em}
  #calmpet-landing .cp-story-review h3{font-size:28px;margin:12px 0}
  #calmpet-landing .cp-story-review p{color:var(--cp-muted)}
  #calmpet-landing .cp-story-review small{display:block;margin-top:28px;font-weight:800;color:var(--cp-muted)}
  #calmpet-landing .cp-carousel-controls{display:flex;justify-content:center;align-items:center;gap:18px;margin-top:20px}
  #calmpet-landing .cp-carousel-arrow{width:42px;height:42px;display:grid;place-items:center;border:1.5px solid var(--cp-ink);border-radius:50%;background:var(--cp-orange);color:#fff;font-size:20px;cursor:pointer}
  #calmpet-landing .cp-carousel-dots{display:flex;gap:8px}
  #calmpet-landing .cp-carousel-dot{width:10px;height:10px;border:0;border-radius:50%;background:var(--cp-border);padding:0;cursor:pointer;transition:transform .28s ease,background .28s ease}
  #calmpet-landing .cp-carousel-dot.active{background:var(--cp-orange);transform:scale(1.2)}

  /* ═══ CTA BAND ═══ */
  #calmpet-landing .cp-cta-band{background:var(--cp-orange);color:#fff;padding:32px 0}
  #calmpet-landing .cp-cta-band .cp-wrap{display:flex;align-items:center;justify-content:space-between;gap:28px}
  #calmpet-landing .cp-cta-band h3{font-size:clamp(24px,3vw,37px);color:#fff}
  #calmpet-landing .cp-cta-band .cp-btn{background:#fff;color:var(--cp-ink);border-color:var(--cp-ink);box-shadow:0 3px 0 var(--cp-ink)}

  /* ═══ AUTHORITY ═══ */
  #calmpet-landing .cp-authority{background:var(--cp-paper)}
  #calmpet-landing .cp-authority-card{max-width:900px;margin:auto;text-align:center;border:1.5px solid var(--cp-ink);border-radius:var(--cp-radius-large);padding:48px 64px;background:#fff;box-shadow:var(--cp-shadow)}
  #calmpet-landing .cp-authority-card .cp-eyebrow{display:inline-block;background:var(--cp-yellow);border-radius:var(--cp-radius-pill);padding:5px 10px;font-size:11px;margin-bottom:24px}
  #calmpet-landing .cp-authority-card blockquote{font:600 clamp(21px,2.5vw,30px)/1.45 var(--cp-font);margin:0 auto 26px;max-width:690px;border:0;padding:0;color:var(--cp-ink)}
  #calmpet-landing .cp-authority-card .cp-caption{font-size:12px;color:var(--cp-muted);max-width:620px;margin:auto}

  /* ═══ COMPARISON ═══ */
  #calmpet-landing .cp-compare{background:var(--cp-cream)}
  #calmpet-landing .cp-brand-compare{max-width:930px;margin:auto;display:grid;grid-template-columns:.8fr 1.4fr .8fr;border:2px solid var(--cp-brown);border-radius:20px;overflow:hidden;background:var(--cp-paper);box-shadow:var(--cp-shadow)}
  #calmpet-landing .cp-brand-side,#calmpet-landing .cp-brand-criteria{display:grid;grid-template-rows:150px repeat(4,minmax(70px,auto))}
  #calmpet-landing .cp-brand-side>div,#calmpet-landing .cp-brand-criteria>div{display:grid;place-items:center;text-align:center;padding:12px;border-bottom:1px solid var(--cp-border)}
  #calmpet-landing .cp-brand-side>div:last-child,#calmpet-landing .cp-brand-criteria>div:last-child{border-bottom:0}
  #calmpet-landing .cp-brand-side-header{align-content:center;gap:8px}
  #calmpet-landing .cp-brand-side-header img{width:110px;height:82px;object-fit:contain}
  #calmpet-landing .cp-brand-side-header b{font-family:var(--cp-font);font-size:14px}
  #calmpet-landing .cp-brand-criteria{background:var(--cp-brown);color:#fff}
  #calmpet-landing .cp-brand-criteria>div{border-color:rgba(255,255,255,.24);font-weight:800;font-size:14px}
  #calmpet-landing .cp-criteria-head{font-family:var(--cp-font);font-size:18px}
  #calmpet-landing .cp-brand-check{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;background:var(--cp-olive-dark);color:#fff;font-weight:900}
  #calmpet-landing .cp-brand-cross{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;background:#939393;color:#fff;font-weight:900}

  /* ═══ OFFER / PDP ═══ */
  #calmpet-landing .cp-offer{background:var(--cp-cream-soft);color:var(--cp-ink)}
  #calmpet-landing .cp-offer-grid{display:grid;grid-template-columns:.96fr 1.04fr;gap:48px;align-items:start}
  #calmpet-landing .cp-gallery{position:sticky;top:24px}
  #calmpet-landing .cp-gallery-main{position:relative;display:grid;place-items:center;aspect-ratio:1/1;background:var(--cp-paper);border:1.5px solid var(--cp-ink);border-radius:var(--cp-radius-large);overflow:hidden;box-shadow:var(--cp-shadow);isolation:isolate}
  #calmpet-landing .cp-gallery-main>img{width:88%;height:88%;object-fit:contain;transition:opacity .18s;position:absolute;inset:0;margin:auto;z-index:1}
  #calmpet-landing .cp-collar-stack{position:absolute;inset:0;z-index:2;transition:opacity .18s}
  #calmpet-landing .cp-collar-stack img{position:absolute;left:50%;top:50%;width:58%;height:58%;object-fit:contain;filter:drop-shadow(0 11px 8px rgba(59,28,6,.18));transition:transform .26s ease}
  #calmpet-landing .cp-collar-stack img:nth-child(1){transform:translate(-50%,-50%) rotate(-8deg)}
  #calmpet-landing .cp-collar-stack img:nth-child(2){transform:translate(-31%,-54%) rotate(8deg)}
  #calmpet-landing .cp-collar-stack img:nth-child(3){transform:translate(-66%,-36%) rotate(-14deg)}
  #calmpet-landing .cp-collar-stack img:nth-child(4){transform:translate(-38%,-31%) rotate(13deg)}
  #calmpet-landing .cp-collar-stack img:nth-child(5){transform:translate(-52%,-44%) rotate(0deg)}
  #calmpet-landing .cp-collar-stack img:nth-child(6){transform:translate(-75%,-51%) rotate(-18deg)}
  #calmpet-landing .cp-collar-stack img:nth-child(7){transform:translate(-27%,-40%) rotate(18deg)}
  #calmpet-landing .cp-collar-stack img:nth-child(8){transform:translate(-52%,-27%) rotate(2deg)}
  #calmpet-landing .cp-gallery-badge{position:absolute;right:16px;top:16px;z-index:4;background:var(--cp-yellow);border:1.5px solid var(--cp-ink);border-radius:var(--cp-radius-pill);padding:8px 11px;font-size:11px;font-weight:900}
  #calmpet-landing .cp-stack-count{position:absolute;left:16px;bottom:16px;z-index:4;background:var(--cp-brown);color:#fff;border:1.5px solid var(--cp-ink);border-radius:var(--cp-radius-pill);padding:8px 12px;font-size:12px;font-weight:900}
  #calmpet-landing .cp-gallery-thumbs{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:10px}
  #calmpet-landing .cp-gallery-thumb{height:92px;padding:6px;background:var(--cp-paper);border:1px solid var(--cp-border);border-radius:14px;cursor:pointer}
  #calmpet-landing .cp-gallery-thumb.active{border:2px solid var(--cp-orange)}
  #calmpet-landing .cp-gallery-thumb img{width:100%;height:100%;object-fit:cover;border-radius:9px}
  #calmpet-landing .cp-gallery-thumb:first-child img{object-fit:contain}
  #calmpet-landing .cp-offer-kicker{display:block;margin:0 0 10px;color:var(--cp-orange);font-size:12px;font-weight:900;letter-spacing:.1em}
  #calmpet-landing .cp-pdp-details h2{max-width:650px;font-size:clamp(41px,4.4vw,59px);line-height:1.03;margin-bottom:12px}
  #calmpet-landing .cp-pdp-sub{font-size:16px;color:var(--cp-muted)}
  #calmpet-landing .cp-pdp-benefits{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:20px 0}
  #calmpet-landing .cp-pdp-benefits span{background:var(--cp-paper);border:1px solid var(--cp-border);border-radius:12px;padding:10px 12px;font-size:12px;font-weight:800}
  #calmpet-landing .cp-options{display:grid;gap:13px;margin-top:22px}
  #calmpet-landing .cp-option{position:relative;display:grid;grid-template-columns:22px 1fr auto;gap:12px;align-items:center;background:var(--cp-paper);border:1.5px solid var(--cp-border);border-radius:16px;padding:16px;cursor:pointer;overflow:hidden}
  #calmpet-landing .cp-option.is-selected{border:2px solid var(--cp-orange);background:#FFF0E3;box-shadow:var(--cp-shadow-playful)}
  #calmpet-landing .cp-option.is-featured{padding-top:35px}
  #calmpet-landing .cp-option input{position:absolute;opacity:0}
  #calmpet-landing .cp-option-radio{width:20px;height:20px;border:2px solid var(--cp-ink);border-radius:50%;display:grid;place-items:center}
  #calmpet-landing .cp-option.is-selected .cp-option-radio:after{content:"";width:10px;height:10px;border-radius:50%;background:var(--cp-orange)}
  #calmpet-landing .cp-option-copy b{display:block;font-family:var(--cp-font);font-size:18px;line-height:1.1}
  #calmpet-landing .cp-option-copy small{display:block;color:var(--cp-muted);font-size:12px;font-weight:700;margin-top:3px}
  #calmpet-landing .cp-deal-line{display:inline-block;margin-top:6px;background:var(--cp-orange);color:#fff;border-radius:var(--cp-radius-pill);padding:4px 8px;font-size:11px;font-weight:900}
  #calmpet-landing .cp-option-price{text-align:right;font-size:22px;font-weight:900;line-height:1}
  #calmpet-landing .cp-option-price .regular{color:#8d6f5c;font-size:12px;font-weight:800}
  #calmpet-landing .cp-option-price small{display:block;color:var(--cp-muted);font-size:11px;margin-top:5px}
  #calmpet-landing .cp-option-price .save{color:var(--cp-olive-dark);font-weight:900}
  #calmpet-landing .cp-ribbon{position:absolute;left:0;right:0;top:0;padding:5px 12px;background:var(--cp-orange);color:#fff;text-align:center;font-size:10px;font-weight:900;letter-spacing:.08em}
  #calmpet-landing .cp-option.cp-family .cp-ribbon{background:var(--cp-brown)}
  /* Bonus panel */
  #calmpet-landing .cp-bonus{margin-top:18px;padding:18px;background:var(--cp-paper);border:1.5px solid var(--cp-ink);border-radius:16px}
  #calmpet-landing .cp-bonus-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px;font:700 16px var(--cp-font)}
  #calmpet-landing .cp-bonus-head small{color:var(--cp-muted);font:800 11px var(--cp-font-ui);letter-spacing:.06em}
  #calmpet-landing .cp-bonus-grid{display:grid;gap:8px}
  #calmpet-landing .cp-bonus-item{display:grid;grid-template-columns:38px 1fr auto;gap:10px;align-items:center;padding:10px;border:1px solid var(--cp-border);border-radius:12px;background:#faf7f1;transition:opacity .18s}
  #calmpet-landing .cp-bonus-item.is-locked{opacity:.48;filter:grayscale(1)}
  #calmpet-landing .cp-bonus-icon{width:38px;height:38px;display:grid;place-items:center;border-radius:10px;background:var(--cp-yellow);color:var(--cp-ink);font-size:16px;font-weight:900}
  #calmpet-landing .cp-bonus-item b{display:block;font-size:13px}
  #calmpet-landing .cp-bonus-item p{margin:1px 0 0;color:var(--cp-muted);font-size:11px;line-height:1.25}
  #calmpet-landing .cp-bonus-status{font-size:10px;font-weight:900;letter-spacing:.06em;color:var(--cp-olive-dark)}
  #calmpet-landing .cp-bonus-item.is-locked .cp-bonus-status{color:var(--cp-muted)}
  /* PDP guarantee inline */
  #calmpet-landing .cp-pdp-guarantee{display:grid;grid-template-columns:54px 1fr;gap:14px;align-items:center;margin-top:20px;padding:15px 16px;background:#FFF0E3;border:1.5px solid var(--cp-orange);border-radius:15px}
  #calmpet-landing .cp-pdp-guarantee-icon{width:54px;height:54px;display:grid;place-items:center;border-radius:50%;background:var(--cp-yellow);border:1.5px solid var(--cp-ink)}
  #calmpet-landing .cp-pdp-guarantee-icon .cp-icon{width:29px;height:29px}
  #calmpet-landing .cp-pdp-guarantee h3{font-size:16px;margin:0 0 4px}
  #calmpet-landing .cp-pdp-guarantee p{font-size:13px;line-height:1.45;color:var(--cp-muted);margin:0}
  #calmpet-landing .cp-checkout{width:100%;margin-top:18px;font-size:16px}
  #calmpet-landing .cp-checkout-note{text-align:center;font-size:12px;color:var(--cp-muted);margin:9px 0 0}
  #calmpet-landing .cp-reassure{display:flex;justify-content:center;flex-wrap:wrap;gap:8px 16px;margin-top:14px;font-size:12px;font-weight:800}
  #calmpet-landing .cp-reassure span:before{content:"✓";color:var(--cp-olive-dark);margin-right:4px}
  /* Offer mini-FAQ */
  #calmpet-landing .cp-mini-faq{margin-top:22px;border-top:1px solid var(--cp-border)}
  #calmpet-landing .cp-mini-faq h3{margin:22px 0 4px;font-size:20px}
  #calmpet-landing .cp-mini-faq details{border-bottom:1px solid var(--cp-border)}
  #calmpet-landing .cp-mini-faq summary{list-style:none;position:relative;padding:15px 28px 15px 0;cursor:pointer;font-size:14px;font-weight:900}
  #calmpet-landing .cp-mini-faq summary::-webkit-details-marker{display:none}
  #calmpet-landing .cp-mini-faq summary:after{content:"+";position:absolute;right:2px;top:12px;color:var(--cp-orange);font-size:20px}
  #calmpet-landing .cp-mini-faq details[open] summary:after{content:"−"}
  #calmpet-landing .cp-mini-faq p{margin:0 0 15px;color:var(--cp-muted);font-size:13px;line-height:1.5}

  /* ═══ PROOF WALL ═══ */
  #calmpet-landing .cp-proof-wall{background:var(--cp-cream-soft);border-top:1px solid var(--cp-border)}
  #calmpet-landing .cp-proof-wall-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  #calmpet-landing .cp-proof-wall-grid article{min-height:160px;background:var(--cp-paper);border:1.5px solid var(--cp-ink);border-radius:var(--cp-radius-card);padding:20px;box-shadow:var(--cp-shadow)}
  #calmpet-landing .cp-proof-wall-grid h3{font-size:18px;margin:12px 0 28px}
  #calmpet-landing .cp-proof-wall-grid p{font-size:12px;color:var(--cp-muted);margin:0}

  /* ═══ GUARANTEE ═══ */
  #calmpet-landing .cp-guarantee{background:var(--cp-yellow);padding:80px 0}
  #calmpet-landing .cp-guarantee-box{max-width:900px;margin:auto;background:#fff;border:2px solid var(--cp-brown);border-radius:var(--cp-radius-large);box-shadow:var(--cp-shadow-playful);padding:40px;display:grid;grid-template-columns:126px 1fr;gap:28px;align-items:center}
  #calmpet-landing .cp-promise-seal{width:116px;height:116px;margin:auto;display:grid;place-items:center;align-content:center;text-align:center;border-radius:50%;background:var(--cp-orange);color:#fff;border:2px solid var(--cp-ink);box-shadow:var(--cp-shadow-playful);transform:rotate(-3deg)}
  #calmpet-landing .cp-promise-seal .cp-icon{width:28px;height:28px;margin-bottom:1px}
  #calmpet-landing .cp-promise-seal b{font:700 32px/1 var(--cp-font);display:block}
  #calmpet-landing .cp-promise-seal span{font-size:10px;font-weight:900;letter-spacing:.07em;line-height:1.05}
  #calmpet-landing .cp-guarantee h2{font-size:clamp(32px,4vw,54px);margin:8px 0 13px}

  /* ═══ FAQ ═══ */
  #calmpet-landing .cp-faq{background:var(--cp-cream)}
  #calmpet-landing .cp-faq h2{text-align:center;margin-bottom:38px}
  #calmpet-landing .cp-faq-list{max-width:850px;margin:auto}
  #calmpet-landing .cp-faq details{border-bottom:1px solid var(--cp-border);padding:24px 4px}
  #calmpet-landing .cp-faq summary{font:600 18px var(--cp-font);cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:20px}
  #calmpet-landing .cp-faq summary::-webkit-details-marker{display:none}
  #calmpet-landing .cp-faq summary:after{content:"+";color:var(--cp-orange);font-size:23px}
  #calmpet-landing .cp-faq details[open] summary:after{content:"−"}
  #calmpet-landing .cp-faq details p{font-size:15px;color:var(--cp-muted);margin:13px 0 2px}

  /* ═══ FINAL CTA ═══ */
  #calmpet-landing .cp-final{background:var(--cp-brown);color:#fff;text-align:center;padding:96px 0}
  #calmpet-landing .cp-final h2{max-width:820px;margin:auto}
  #calmpet-landing .cp-final p{max-width:660px;color:#efd7c2;margin:20px auto 28px}

  /* ═══ STICKY BAR ═══ */
  #calmpet-landing .cp-sticky{position:fixed;left:0;right:0;bottom:0;z-index:30;background:rgba(255,253,249,.96);backdrop-filter:blur(10px);border-top:1px solid var(--cp-border);padding:10px 0;transform:translateY(120%);transition:.25s}
  #calmpet-landing .cp-sticky.is-showing{transform:none}
  #calmpet-landing .cp-sticky-in{display:flex;justify-content:space-between;align-items:center;gap:18px}
  #calmpet-landing .cp-sticky-copy{font-weight:900;line-height:1.2}
  #calmpet-landing .cp-sticky-copy small{display:block;font-size:11px;color:var(--cp-muted)}
  #calmpet-landing .cp-sticky .cp-btn{padding:11px 18px;box-shadow:none}

  /* ═══ FOCUS STATES ═══ */
  #calmpet-landing .cp-btn:focus-visible,#calmpet-landing .cp-carousel-arrow:focus-visible,#calmpet-landing .cp-carousel-dot:focus-visible,#calmpet-landing .cp-gallery-thumb:focus-visible,#calmpet-landing .cp-option:focus-within,#calmpet-landing .cp-faq summary:focus-visible{outline:3px solid var(--cp-yellow);outline-offset:3px}

  /* ═══ RESPONSIVE ═══ */
  @media(max-width:980px){#calmpet-landing .cp-steps{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:860px){
    #calmpet-landing .cp-nav-links a:not(.cp-mini-cta){display:none}
    #calmpet-landing .cp-wrap{width:min(100% - 40px,1240px)}
    #calmpet-landing section{padding:72px 0}
    #calmpet-landing h1{font-size:clamp(40px,10vw,46px)}
    #calmpet-landing h2{font-size:clamp(32px,8vw,38px)}
    #calmpet-landing .cp-hero-grid,#calmpet-landing .cp-split,#calmpet-landing .cp-offer-grid{grid-template-columns:1fr}
    #calmpet-landing .cp-hero-grid{gap:40px}
    #calmpet-landing .cp-hero-photo img{height:520px}
    #calmpet-landing .cp-paw{right:8px}
    #calmpet-landing .cp-proof-row{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;padding:4px 2px 16px;scrollbar-width:none}
    #calmpet-landing .cp-proof-row::-webkit-scrollbar{display:none}
    #calmpet-landing .cp-proof-card{flex:0 0 min(76vw,520px);scroll-snap-align:start}
    #calmpet-landing .cp-story-slide{grid-template-columns:1fr}
    #calmpet-landing .cp-story-photo{min-height:0;aspect-ratio:4/3}
    #calmpet-landing .cp-cta-band .cp-wrap{display:block;text-align:center}
    #calmpet-landing .cp-cta-band .cp-btn{margin-top:20px}
    #calmpet-landing .cp-gallery{position:relative;top:auto}
    #calmpet-landing .cp-brand-compare{grid-template-columns:.72fr 1.35fr .72fr}
    #calmpet-landing .cp-brand-side-header img{width:82px;height:66px}
    #calmpet-landing .cp-brand-side-header b{font-size:12px}
    #calmpet-landing .cp-brand-criteria>div{font-size:12px;padding:10px 6px}
    #calmpet-landing .cp-guarantee-box{grid-template-columns:1fr;text-align:center}
    #calmpet-landing .cp-promise-seal{margin:0 auto}
    #calmpet-landing .cp-proof-wall-grid{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;padding:2px 2px 14px;scrollbar-width:none}
    #calmpet-landing .cp-proof-wall-grid::-webkit-scrollbar{display:none}
    #calmpet-landing .cp-proof-wall-grid article{flex:0 0 min(78vw,340px);scroll-snap-align:start}
    #calmpet-landing .cp-failed-visual img{min-height:440px}
    #calmpet-landing .cp-pdp-details h2{font-size:clamp(39px,7vw,52px)}
  }
  @media(max-width:540px){
    #calmpet-landing .cp-wrap,#calmpet-landing .cp-narrow{width:min(100% - 32px,1240px)}
    #calmpet-landing section{padding:58px 0}
    #calmpet-landing .cp-nav{height:64px}
    #calmpet-landing .cp-logo{width:136px;max-width:136px}
