  <div class="cp-sticky" id="calmpet-sticky"><div class="cp-wrap cp-sticky-in"><div class="cp-sticky-copy"><span id="calmpet-sticky-title">10-Month CalmPet Bundle | $98</span><small id="calmpet-sticky-sub">Buy 2, get 3 free | $19.60 each | no subscription</small></div><a class="cp-btn" href="#offer">Choose your bundle</a></div></div>
</div>

<script>
  (() => {
    const root = document.getElementById('calmpet-landing'); if (!root) return;
    const options = [...root.querySelectorAll('.cp-option')], variant = root.querySelector('#calmpet-variant'), checkout = root.querySelector('#calmpet-checkout'), sticky = root.querySelector('#calmpet-sticky'), title = root.querySelector('#calmpet-sticky-title'), sub = root.querySelector('#calmpet-sticky-sub'), form = root.querySelector('#calmpet-offer-form'), stack = root.querySelector('#calmpet-collar-stack'), stackCount = root.querySelector('#calmpet-stack-count'), bonuses = [...root.querySelectorAll('.cp-bonus-item')];
    const syncBundle = option => { options.forEach(item => item.classList.toggle('is-selected', item === option)); option.querySelector('input').checked = true; variant.value = option.dataset.variant; checkout.textContent = option.dataset.cta; title.textContent = option.dataset.title; sub.textContent = option.dataset.sub; const count = Number(option.dataset.count), level = Number(option.dataset.level); if (stack) [...stack.children].forEach((image, index) => image.hidden = index >= count); if (stackCount) stackCount.textContent = `${count} ${count === 1 ? 'COLLAR' : 'COLLARS'}`; bonuses.forEach(item => { const unlocked = Number(item.dataset.bonus) <= level; item.classList.toggle('is-locked', !unlocked); item.querySelector('.cp-bonus-status').textContent = unlocked ? 'UNLOCKED' : 'LOCKED'; }); };
    options.forEach(option => option.addEventListener('click', () => syncBundle(option)));
    const initial = root.querySelector('.cp-option.is-selected'); if (initial) syncBundle(initial);
    const hero = root.querySelector('.cp-hero'); if (hero && 'IntersectionObserver' in window) new IntersectionObserver(([entry]) => sticky.classList.toggle('is-showing', !entry.isIntersecting), { threshold: .1 }).observe(hero);
    if (form) form.addEventListener('submit', async event => {
      event.preventDefault();
      const selected = root.querySelector('.cp-option.is-selected');
      if (!selected || !selected.dataset.variant) return;
      const originalLabel = checkout.textContent;
      checkout.disabled = true; checkout.setAttribute('aria-busy', 'true'); checkout.textContent = 'Adding to cart…';
      try {
        await fetch('{{ routes.cart_clear_url }}', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        const response = await fetch('{{ routes.cart_add_url }}', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }, body: JSON.stringify({ items: [{ id: Number(selected.dataset.variant), quantity: Number(selected.dataset.quantity) || 1 }] }) });
        const result = await response.json();
        if (!response.ok || result.status) throw new Error('Could not add the selected bundle.');
        const drawer = document.querySelector('cart-drawer');
        if (!drawer) { window.location.assign('{{ routes.cart_url }}'); return; }
        const drawerResponse = await fetch('{{ routes.root_url }}?section_id=cart-drawer');
        const drawerMarkup = await drawerResponse.text();
        const parsed = new DOMParser().parseFromString(drawerMarkup, 'text/html');
        const refreshedDrawer = parsed.querySelector('cart-drawer');
        if (refreshedDrawer && refreshedDrawer.querySelector('.drawer__inner') && drawer.querySelector('.drawer__inner')) {
          drawer.querySelector('.drawer__inner').innerHTML = refreshedDrawer.querySelector('.drawer__inner').innerHTML;
          drawer.classList.remove('is-empty');
        }
        const cart = await fetch('{{ routes.cart_url }}.js').then(response => response.json());
        document.querySelectorAll('#cart-icon-bubble .cart-count-bubble').forEach(bubble => {
          const count = bubble.querySelector('[aria-hidden]'); const label = bubble.querySelector('.visually-hidden');
          if (count) count.textContent = cart.item_count;
          if (label) label.textContent = `${cart.item_count} items`;
        });
        drawer.open(checkout);
      } catch (error) {
        window.location.assign('{{ routes.cart_url }}');
      } finally {
        checkout.disabled = false; checkout.removeAttribute('aria-busy'); checkout.textContent = originalLabel;
      }
    });
  })();
</script>

