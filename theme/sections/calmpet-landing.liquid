</div>

<script>
  (() => {
    const root = document.getElementById('calmpet-landing');
    if (!root) return;

    /* ═══ OFFER CARD SELECTION ═══ */
    const options = [...root.querySelectorAll('.cp-option')];
    const variant = root.querySelector('#cp-variant');
    const checkout = root.querySelector('#cp-checkout');
    const sticky = root.querySelector('#cp-sticky');
    const stickyTitle = root.querySelector('#cp-sticky-title');
    const stickySub = root.querySelector('#cp-sticky-sub');
    const bonuses = [...root.querySelectorAll('.cp-bonus-item')];
    const mainImage = root.querySelector('#cp-main-image');
    const thumbs = [...root.querySelectorAll('.cp-gallery-thumb')];

    const syncBundle = option => {
      options.forEach(item => {
        const selected = item === option;
        item.classList.toggle('is-selected', selected);
      });
      option.querySelector('input').checked = true;
      if (variant) variant.value = option.dataset.variant;
      if (checkout) checkout.textContent = option.dataset.cta;
      if (stickyTitle) stickyTitle.textContent = option.dataset.title;
      if (stickySub) stickySub.textContent = option.dataset.sub;
      const level = Number(option.dataset.level);
      bonuses.forEach(item => {
        item.classList.toggle('is-locked', Number(item.dataset.bonus) > level);
      });
    };
    options.forEach(o => {
      const radio = o.querySelector('input[type="radio"]');
      if (radio) radio.addEventListener('change', () => syncBundle(o));
      o.addEventListener('click', e => {
        if (e.target !== radio) { e.preventDefault(); if (radio) { radio.checked = true; radio.dispatchEvent(new Event('change')); } }
      });
    });
    const initial = root.querySelector('.cp-option.is-selected');
    if (initial) syncBundle(initial);

    /* ═══ GALLERY THUMBNAILS ═══ */
    thumbs.forEach(thumb => thumb.addEventListener('click', () => {
      thumbs.forEach(t => t.classList.remove('active'));
      thumb.classList.add('active');
      if (mainImage) {
        mainImage.style.opacity = '0';
        setTimeout(() => {
          mainImage.src = thumb.dataset.src;
          mainImage.alt = thumb.dataset.alt;
          mainImage.style.objectFit = thumb.dataset.fit;
          mainImage.style.width = '100%';
          mainImage.style.height = '100%';
          mainImage.style.opacity = '1';
        }, 140);
      }
    }));

    /* ═══ STORY CAROUSEL ═══ */
    const storyTrack = root.querySelector('#cp-story-track');
    const slides = [...root.querySelectorAll('.cp-story-slide')];
    const storyDots = [...root.querySelectorAll('.cp-carousel-dot')];
    let storyIndex = 0;
    let storyFrame;
    const setStoryIndex = index => {
      storyIndex = index;
      slides.forEach((s, i) => s.classList.toggle('is-active', i === index));
      storyDots.forEach((d, i) => d.classList.toggle('active', i === index));
    };
    const syncStoryIndex = () => {
      if (!storyTrack) return;
      const edge = storyTrack.getBoundingClientRect().left;
      let closest = 0, distance = Infinity;
      slides.forEach((slide, i) => {
        const d = Math.abs(slide.getBoundingClientRect().left - edge);
        if (d < distance) { closest = i; distance = d; }
      });
      setStoryIndex(closest);
    };
    const scrollToStory = index => {
      const next = (index + slides.length) % slides.length;
      if (storyTrack && slides[next]) storyTrack.scrollTo({ left: slides[next].offsetLeft - slides[0].offsetLeft, behavior: 'smooth' });
    };
    if (storyTrack) {
      storyTrack.addEventListener('scroll', () => { cancelAnimationFrame(storyFrame); storyFrame = requestAnimationFrame(syncStoryIndex); }, { passive: true });
      storyDots.forEach((d, i) => d.addEventListener('click', () => scrollToStory(i)));
      const prev = root.querySelector('#cp-story-prev');
      const next = root.querySelector('#cp-story-next');
      if (prev) prev.addEventListener('click', () => scrollToStory(storyIndex - 1));
      if (next) next.addEventListener('click', () => scrollToStory(storyIndex + 1));
      window.addEventListener('resize', syncStoryIndex, { passive: true });
    }

    /* ═══ STICKY BAR ═══ */
    const hero = root.querySelector('.cp-hero');
    const offer = root.querySelector('#offer');
    if (hero && offer && sticky && 'IntersectionObserver' in window) {
      let heroVisible = true;
      let offerVisible = false;
      const syncSticky = () => sticky.classList.toggle('is-showing', !heroVisible && !offerVisible);
      new IntersectionObserver(([entry]) => { heroVisible = entry.isIntersecting; syncSticky(); }, { threshold: .1 }).observe(hero);
      new IntersectionObserver(([entry]) => { offerVisible = entry.isIntersecting; syncSticky(); }, { threshold: .05 }).observe(offer);
    }

    /* ═══ CART SUBMISSION ═══ */
    const form = root.querySelector('#cp-offer-form');
    if (form) form.addEventListener('submit', async event => {
      event.preventDefault();
      const selected = root.querySelector('.cp-option.is-selected');
      if (!selected || !selected.dataset.variant) return;
      const label = checkout.textContent;
      checkout.disabled = true;
      checkout.setAttribute('aria-busy', 'true');
      checkout.textContent = 'Adding your bundle…';
      try {
        if (!window.cpCalmPetCart) throw new Error('Cart drawer is not ready.');
        await window.cpCalmPetCart.setBundle(Number(selected.dataset.variant), Number(selected.dataset.quantity) || 1, checkout);
      } catch (e) {
        checkout.textContent = 'Please try again';
        setTimeout(() => { checkout.textContent = label; }, 1800);
      } finally {
        checkout.disabled = false;
        checkout.removeAttribute('aria-busy');
        if (checkout.textContent !== 'Please try again') checkout.textContent = label;
      }
    });
  })();
</script>

