  #calmpet-landing .cp-hero-photo{position:relative} #calmpet-landing .cp-hero-photo img,#calmpet-landing .cp-media-placeholder{width:100%;height:640px;object-fit:cover;border:2px solid var(--cp-brown);border-radius:36px 36px 110px 36px;box-shadow:11px 12px 0 var(--cp-brown)} #calmpet-landing .cp-media-placeholder{display:grid;place-items:center;background:var(--cp-sand);color:var(--cp-muted);font-size:.8rem;font-weight:900;letter-spacing:.1em;text-align:center;padding:20px} #calmpet-landing .cp-photo-note{position:absolute;left:-22px;bottom:28px;background:var(--cp-paper);border:1.5px solid var(--cp-brown);border-radius:15px;padding:13px 17px;font-size:.78rem;font-weight:900;box-shadow:5px 6px 0 var(--cp-orange)} #calmpet-landing .cp-paw{position:absolute;right:-16px;top:36px;width:60px;height:60px;border-radius:50%;background:var(--cp-yellow);border:1.5px solid var(--cp-ink);display:grid;place-items:center;font-size:1.5rem;transform:rotate(9deg)}
  #calmpet-landing .cp-marquee{background:var(--cp-paper);border-block:1px solid var(--cp-line);overflow:hidden;padding:15px 0} #calmpet-landing .cp-marquee-track{display:flex;width:max-content;animation:cp-roll 28s linear infinite} #calmpet-landing .cp-marquee-set{display:flex;align-items:center} #calmpet-landing .cp-marquee-item{white-space:nowrap;font-size:.84rem;font-weight:800;margin-right:48px} #calmpet-landing .cp-marquee-item i{font-style:normal;display:inline-grid;place-items:center;width:29px;height:29px;margin-right:9px;border-radius:50%;background:var(--cp-yellow)} @keyframes cp-roll{to{transform:translateX(-50%)}}
  #calmpet-landing .cp-proof{background:var(--cp-paper)} #calmpet-landing .cp-proof-intro{max-width:760px;margin-bottom:32px} #calmpet-landing .cp-proof-row{display:grid;grid-template-columns:repeat(3,1fr);gap:18px} #calmpet-landing .cp-proof-card{border:1px solid var(--cp-line);border-radius:18px;overflow:hidden;background:#fff} #calmpet-landing .cp-proof-photo{height:180px;background:var(--cp-sand);display:grid;place-items:center;text-align:center;color:var(--cp-muted);font-size:.72rem;font-weight:900;letter-spacing:.08em} #calmpet-landing .cp-proof-body{padding:20px} #calmpet-landing .cp-proof-body h3{margin:10px 0 7px} #calmpet-landing .cp-proof-body p,#calmpet-landing .cp-proof-body small{color:var(--cp-muted);font-size:.86rem}
