{%- assign product_handle = section.settings.product | default: settings.lp_product -%}
{%- assign product = all_products[product_handle] -%}
{%- assign variant_one = product.variants.first -%}
{%- assign variant_five = product.variants[1] | default: product.variants.first -%}
{%- assign variant_eight = product.variants[2] | default: product.variants.last -%}
{%- assign hero_image = section.settings.hero_image | default: product.images[2] | default: product.featured_image -%}
{%- assign lifestyle_image = section.settings.lifestyle_image | default: product.images[1] | default: product.featured_image -%}
{%- assign product_image = section.settings.product_image | default: product.featured_image -%}
{%- assign proof_titles = 'Calmer when home alone|An easier walk around the block|Settling sooner after a trigger' | split: '|' -%}
{%- assign story_titles = 'The first quiet hour at home|A walk that finally felt manageable|Settling sooner after the noise stopped' | split: '|' -%}
{%- assign proof_wall_titles = 'Home-alone experience|Walking and reactivity experience|Noise and visitors experience|Settling and sleep experience|Indoor stress behavior experience|Rescue dog confidence experience' | split: '|' -%}

<style>
  #calmpet-landing { --cp-orange:#fd7100;--cp-orange-light:#ff8a2e;--cp-brown:#482206;--cp-ink:#3b1c06;--cp-cream:#fff8ef;--cp-sand:#f3e4d1;--cp-paper:#fffdf9;--cp-olive:#7d885b;--cp-yellow:#ffd56a;--cp-line:#e5d4c1;--cp-muted:#765943;--cp-shadow:0 18px 50px rgba(72,34,6,.11);background:var(--cp-cream);color:var(--cp-ink);font-family:"Nunito Sans",system-ui,sans-serif;font-size:17px;line-height:1.58;overflow:hidden}
