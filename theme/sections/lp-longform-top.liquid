{%- assign lt_midcta_sub = "Lower the background stress. Rebuild the Safety Margin. Try the CalmPet Collar for a full 60 days without risking a cent." -%}
{%- assign lt_midcta_cta = "CHOOSE MY CALMPET SUPPLY ↑" -%}

{%- assign lt_how_heading = "How CalmPet Helps" -%}
