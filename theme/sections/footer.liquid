
{%- comment -%}
  CalmPet footer — compact support and legal navigation
{%- endcomment -%}

{%- assign footer_logo = images['CalmPet_Logo.png'] | default: settings.logo -%}
{%- assign support_email = settings.lp_support_email | default: 'hello@calmpet.club' -%}

<footer class="lp-footer">
  <div class="lp-footer-inner">
    <a href="{{ routes.root_url }}" class="lp-footer-brand" aria-label="CalmPet home">{% if footer_logo != blank %}{{ footer_logo | image_url: width: 340 | image_tag: alt: 'CalmPet', loading: 'lazy' }}{% else %}Calm<span>Pet</span>{% endif %}</a>
    <nav class="lp-footer-links" aria-label="Support and legal information">
      <a href="mailto:{{ support_email }}">Contact</a>
      <a href="/policies/shipping-policy">Shipping</a>
      <a href="/policies/refund-policy">Returns</a>
      <a href="/policies/privacy-policy">Privacy</a>
      <a href="/policies/terms-of-service">Terms</a>
    </nav>
    <p class="lp-footer-disclaimer">CalmPet supports everyday calm and is not intended to diagnose, treat, cure, or prevent disease. Individual results vary.</p>
    <p class="lp-footer-copyright">© {{ 'now' | date: '%Y' }} CalmPet.club</p>
  </div>
</footer>

{% stylesheet %}
  .lp-footer {
    background: #301500;
    color: rgba(255, 255, 255, 0.7);
    padding: 32px 18px 86px;
  }
  .lp-footer-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .lp-footer-brand {
    display: block;
    width: 172px;
    margin: 0 auto 20px;
    padding: 9px 13px;
    background: #fff6ea;
    border-radius: 12px;
    color: #fff;
    font-family: "Fredoka", "Arial Rounded MT Bold", sans-serif;
    font-size: 3rem;
    font-weight: 700;
    letter-spacing: -.08em;
    text-decoration: none;
    white-space: nowrap;
  }
  .lp-footer-brand img { width: 100%; height: auto; }
  .lp-footer-brand span { color: #fd7100; }
  .lp-footer-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px 22px;
  }
  .lp-footer-links a {
    color: rgba(255,255,255,.68);
    font-size: 1.15rem;
    text-decoration: none;
  }
  .lp-footer-links a:hover { color: #fff; text-decoration: underline; }
  .lp-footer-disclaimer {
    max-width: 720px;
    margin: 22px auto 0;
    color: rgba(255,255,255,.42);
    font-size: 1rem;
    line-height: 1.45;
    text-align: center;
  }
  .lp-footer-copyright {
    margin: 12px 0 0;
    color: rgba(255,255,255,.48);
    font-size: 1rem;
    text-align: center;
  }
  @media screen and (max-width: 749px) {
    .lp-footer { padding-top: 28px; }
    .lp-footer-brand { width: 154px; }
    .lp-footer-links { gap: 9px 18px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "class": "section-wrapper",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title_1",
      "label": "Column 1 title",
      "default": "Support"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Column 1 menu"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Column 2 title",
      "default": "Legal"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Column 2 menu"
    }
  ]
}
{% endschema %}
