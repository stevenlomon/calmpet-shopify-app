
{%- comment -%}
  CalmPet footer — compact support and legal navigation
{%- endcomment -%}

<footer class="lp-footer">
  <div class="lp-footer-inner">
    <div class="lp-footer-content">
      <a href="{{ routes.root_url }}" class="lp-footer-brand">CalmPet<span>•</span></a>
      <p>CalmPet is a pet-wellness product designed to support calmer behavior. Individual results vary. It is not intended to diagnose, treat, cure, or prevent disease. Serious or sudden behavioral concerns should be discussed with a veterinarian. © {{ 'now' | date: '%Y' }} CalmPet.club</p>
    </div>
  </div>
</footer>

{% stylesheet %}
  .lp-footer {
    background: #3F3D3D;
    color: rgba(255, 255, 255, 0.7);
    padding: 38px 18px 88px;
  }
  .lp-footer-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .lp-footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 3rem;
    max-width: 1180px;
    margin: 0 auto;
  }
  .lp-footer-brand {
    color: #fff;
    font-family: "Fredoka", "Arial Rounded MT Bold", sans-serif;
    font-size: 3rem;
    font-weight: 700;
    letter-spacing: -.08em;
    text-decoration: none;
    white-space: nowrap;
  }
  .lp-footer-brand span { color: #fd7100; }
  .lp-footer-content p {
    color: #d4b69d;
    font-size: 1.2rem;
    line-height: 1.5;
    max-width: 690px;
    margin: 0;
  }
  @media screen and (min-width: 750px) {
    .lp-footer-content { max-width: 1100px; }
  }
  @media screen and (max-width: 749px) {
    .lp-footer-content { display: block; }
    .lp-footer-brand { display: inline-block; margin-bottom: 1.8rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "class": "section-wrapper",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title_1",
      "label": "Column 1 title",
      "default": "Support"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Column 1 menu"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Column 2 title",
      "default": "Legal"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Column 2 menu"
    }
  ]
}
{% endschema %}
