<script>
function toggleFaq(trigger) {
  trigger.closest('.faq-item').classList.toggle('open');
}

document.addEventListener('DOMContentLoaded', function() {
  var sticky = document.getElementById('sticky-cart');
  var trigger = document.querySelector('.hero');
  if (!sticky || !trigger) return;
  document.body.appendChild(sticky);

  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (!entry.isIntersecting && entry.boundingClientRect.top < 0) {
        sticky.classList.remove('hero-hidden');
        sticky.classList.add('visible');
      } else {
        sticky.classList.add('hero-hidden');
        sticky.addEventListener('transitionend', function handler() {
          if (sticky.classList.contains('hero-hidden')) {
            sticky.classList.remove('visible');
          }
          sticky.removeEventListener('transitionend', handler);
        });
      }
    });
  }, { root: null, threshold: 0 });

  observer.observe(trigger);

  var footer = document.querySelector('.lp-footer');
  if (footer) {
    var footerVisible = false;
    var footerObs = new IntersectionObserver(function(entries) {
      footerVisible = entries[0].isIntersecting;
      if (footerVisible) {
        sticky.classList.add('footer-hidden');
      } else {
        sticky.classList.remove('footer-hidden');
      }
    }, { root: null, threshold: 0 });
    footerObs.observe(footer);
  }

  var drawerObs = new MutationObserver(function() {
    var drawer = document.querySelector('cart-drawer');
    if (drawer && drawer.classList.contains('active')) {
      sticky.classList.add('drawer-open');
    } else {
      sticky.classList.remove('drawer-open');
    }
  });
  var drawerEl = document.querySelector('cart-drawer');
  if (drawerEl) {
    drawerObs.observe(drawerEl, { attributes: true, attributeFilter: ['class'] });
  }
});

(function() {
  var cards = document.getElementById('review-cards');
  var dotsWrap = document.getElementById('carousel-dots');
  var prev = document.querySelector('.carousel-prev');
  var next = document.querySelector('.carousel-next');
  if (!cards || !dotsWrap) return;

  var items = Array.prototype.slice.call(cards.querySelectorAll('.review-card'));
  var dots = [];

  items.forEach(function(_, i) {
    var d = document.createElement('button');
    d.className = 'carousel-dot' + (i === 0 ? ' active' : '');
    d.setAttribute('aria-label', 'Go to review ' + (i + 1));
    d.addEventListener('click', function() {
      var max = cards.scrollWidth - cards.clientWidth;
      cards.scrollTo({ left: (i / (items.length - 1)) * max, behavior: 'smooth' });
    });
    dotsWrap.appendChild(d);
    dots.push(d);
  });

  function getStep() {
    return items.length > 1 ? items[1].offsetLeft - items[0].offsetLeft : items[0].offsetWidth;
  }

  function update() {
    var max = cards.scrollWidth - cards.clientWidth;
    var idx = max > 0 ? Math.round((cards.scrollLeft / max) * (items.length - 1)) : 0;
    idx = Math.max(0, Math.min(idx, items.length - 1));
    dots.forEach(function(d, i) { d.classList.toggle('active', i === idx); });
    if (prev) prev.disabled = cards.scrollLeft <= 5;
    if (next) next.disabled = cards.scrollLeft >= max - 5;
  }

  cards.addEventListener('scroll', update, { passive: true });

  if (prev) prev.addEventListener('click', function() {
    cards.scrollBy({ left: -getStep(), behavior: 'smooth' });
  });
  if (next) next.addEventListener('click', function() {
    cards.scrollBy({ left: getStep(), behavior: 'smooth' });
  });

  update();
})();
</script>

