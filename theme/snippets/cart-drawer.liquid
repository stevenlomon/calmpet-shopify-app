{%- assign cp_product_handle = settings.lp_product | default: 'adjustable-pet-calming-collar' -%}
{%- assign cp_product = all_products[cp_product_handle] -%}
{%- assign cp_variant_one = cp_product.variants.first -%}
{%- assign cp_variant_five = cp_product.variants[1] | default: cp_product.variants.first -%}
{%- assign cp_variant_eight = cp_product.variants[2] | default: cp_product.variants.last -%}

<cart-drawer class="drawer cp-cart-drawer{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cp-drawer-shell">
    <div id="CartDrawer-Overlay" class="cp-drawer-overlay"></div>
    <div class="drawer__inner cp-drawer-panel" role="dialog" aria-modal="true" aria-label="Your CalmPet cart" tabindex="-1">
      <header class="cp-drawer-header">
        <div><span class="cp-drawer-eyebrow">CALMPET</span><h2>Your cart</h2></div>
        <button class="drawer__close cp-drawer-close" type="button" aria-label="Close cart" onclick="this.closest('cart-drawer').close()">×</button>
      </header>
      <div class="cp-drawer-urgency" id="cp-drawer-urgency" hidden>
        <strong>CalmPet Collars are selling fast.</strong>
        <span>Your selected offer is held for <b id="cp-cart-timer">05:00</b></span>
      </div>
      <div class="cp-drawer-scroll">
        <div class="cp-drawer-loading" id="cp-drawer-loading">Updating your cart…</div>
        <div class="cp-drawer-empty" id="cp-drawer-empty" hidden>
          <h3>Your cart is empty</h3>
          <p>Choose the CalmPet bundle that fits your dog and household.</p>
          <button type="button" onclick="this.closest('cart-drawer').close();document.querySelector('#offer')?.scrollIntoView({behavior:'smooth'})">Choose your bundle</button>
        </div>
        <div class="cp-drawer-expired" id="cp-drawer-expired" hidden>
          <strong>Your CalmPet offer has expired.</strong>
          <span>Refresh availability to restore your bundle.</span>
          <button type="button" data-cp-action="restore">Restore my bundle</button>
        </div>
        <div id="cp-drawer-items" class="cp-drawer-items" aria-live="polite"></div>
        <section class="cp-drawer-edit" id="cp-drawer-edit" hidden>
          <div class="cp-drawer-section-head"><strong>Change bundle</strong><button type="button" data-cp-action="close-edit">Done</button></div>
          <div class="cp-drawer-bundle-list">
            <button type="button" data-cp-action="select-bundle" data-variant="{{ cp_variant_one.id }}" data-quantity="1"><span><b>Try CalmPet</b><small>1 collar · up to 60 days</small></span><strong>$49</strong></button>
            <button type="button" data-cp-action="select-bundle" data-variant="{{ cp_variant_five.id }}" data-quantity="5"><span><b>Buy 2, Get 3 FREE</b><small>5 collars · up to 10 months</small></span><strong>$98</strong></button>
            <button type="button" data-cp-action="select-bundle" data-variant="{{ cp_variant_eight.id }}" data-quantity="8"><span><b>Buy 3, Get 5 FREE</b><small>8 collars · multi-dog families</small></span><strong>$147</strong></button>
          </div>
        </section>
        <section class="cp-drawer-gifts" id="cp-drawer-gifts" hidden>
          <strong>YOUR GIFTS</strong>
          <div id="cp-drawer-gift-list"></div>
        </section>
        <div class="cp-drawer-proof" id="cp-drawer-proof" hidden>
          <div class="cp-drawer-rating"><span>★★★★★</span><b>4.7/5</b> · Trusted by 1,267 Dog Parents</div>
          <div>✓ ONE-TIME PURCHASE · NO SUBSCRIPTION</div>
          <div>✓ Protected by the CalmPet 60-Day Promise</div>
        </div>
      </div>
      <footer class="cp-drawer-footer" id="cp-drawer-footer" hidden>
        <div class="cp-drawer-total"><span>Subtotal</span><strong id="cp-drawer-total">$0</strong></div>
        <a href="/checkout" class="cp-drawer-checkout" id="cp-drawer-checkout">CONTINUE TO SECURE CHECKOUT →</a>
        <small>Taxes calculated at checkout</small>
      </footer>
    </div>
  </div>
</cart-drawer>

<script type="application/json" id="cp-cart-config">
{"productId":{{ cp_product.id | json }},"image":{% if cp_product.featured_image %}{{ cp_product.featured_image | image_url: width: 360 | json }}{% else %}null{% endif %},"offers":[{"variantId":{{ cp_variant_one.id | json }},"quantity":1,"level":1,"name":"Try CalmPet Collar","useCase":"1 collar · up to 60 days for one dog","price":4900,"anchor":6900,"perUnit":"$49 per collar","saving":"Save $20"},{"variantId":{{ cp_variant_five.id | json }},"quantity":5,"level":2,"name":"Buy 2, Get 3 FREE","useCase":"5 CalmPet Collars · up to 10 months","price":9800,"anchor":34500,"perUnit":"$19.60 per collar","saving":"Save $247 · 72%"},{"variantId":{{ cp_variant_eight.id | json }},"quantity":8,"level":3,"name":"Buy 3, Get 5 FREE","useCase":"8 CalmPet Collars · multi-dog families","price":14700,"anchor":55200,"perUnit":"$18.38 per collar","saving":"Save $405 · 73%"}]}
</script>

<style>
  cart-drawer.cp-cart-drawer{position:fixed;inset:0;z-index:10000;display:block;visibility:hidden;font-family:"Nunito Sans",sans-serif;color:#3B1C06}
  cart-drawer.cp-cart-drawer.active{visibility:visible}
  .cp-drawer-shell{position:absolute;inset:0;display:flex;justify-content:flex-end}
  .cp-drawer-overlay{position:absolute;inset:0;background:rgba(40,19,4,.48);opacity:0;transition:opacity .22s ease}
  .cp-cart-drawer.active .cp-drawer-overlay{opacity:1}
  .cp-drawer-panel{position:relative;z-index:2;width:min(480px,100vw);height:100%;max-height:100vh;display:grid;grid-template-rows:auto auto minmax(0,1fr) auto;background:#FFF6EA;box-shadow:-12px 0 40px rgba(59,28,6,.18);transform:translateX(100%);transition:transform .25s ease;overflow:hidden}
  .cp-cart-drawer.active .cp-drawer-panel{transform:translateX(0)}
  .cp-drawer-header{display:flex;align-items:center;justify-content:space-between;padding:22px 22px 16px;background:#FFFDF9;border-bottom:1px solid #E8D8C3}
  .cp-drawer-header h2{margin:0;font:700 30px/1 "Fredoka",sans-serif;color:#3B1C06}
  .cp-drawer-eyebrow{display:block;margin-bottom:4px;color:#FD7100;font-size:10px;font-weight:900;letter-spacing:.12em}
  .cp-drawer-close{width:42px;height:42px;border:0;background:transparent;color:#3B1C06;font-size:38px;font-weight:300;line-height:1;cursor:pointer}
  .cp-drawer-urgency{padding:13px 20px;background:#FFF0E3;border-bottom:1px solid #FD7100;text-align:center}
  .cp-drawer-urgency strong,.cp-drawer-urgency span{display:block}
  .cp-drawer-urgency strong{font:700 16px/1.2 "Fredoka",sans-serif}
  .cp-drawer-urgency span{margin-top:3px;font-size:13px}
  .cp-drawer-urgency b{color:#FD7100;font-variant-numeric:tabular-nums}
  .cp-drawer-scroll{overflow-y:auto;padding:18px 20px 24px;overscroll-behavior:contain}
  .cp-drawer-loading{text-align:center;padding:36px 0;color:#765943;font-size:14px;font-weight:800}
  .cp-drawer-empty,.cp-drawer-expired{padding:42px 14px;text-align:center}
  .cp-drawer-empty h3{margin:0 0 8px;font:700 25px "Fredoka",sans-serif}
  .cp-drawer-empty p{margin:0 0 18px;color:#765943}
  .cp-drawer-empty button,.cp-drawer-expired button{min-height:46px;padding:11px 18px;border:1.5px solid #3B1C06;border-radius:12px;background:#FD7100;color:#fff;font-weight:900;cursor:pointer}
  .cp-drawer-expired{margin-bottom:16px;padding:18px;border:1.5px solid #FD7100;border-radius:14px;background:#FFF0E3}
  .cp-drawer-expired strong,.cp-drawer-expired span{display:block}
  .cp-drawer-expired span{margin:5px 0 14px;color:#765943;font-size:13px}
  .cp-drawer-item{display:grid;grid-template-columns:92px minmax(0,1fr);gap:14px;padding:0 0 18px;border-bottom:1px solid #E8D8C3}
  .cp-drawer-item+.cp-drawer-item{padding-top:18px}
  .cp-drawer-item img{width:92px;height:92px;object-fit:cover;border:1px solid #E8D8C3;border-radius:14px;background:#FFFDF9}
  .cp-drawer-item-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
  .cp-drawer-item h3{margin:0;font:700 18px/1.1 "Fredoka",sans-serif;color:#3B1C06}
  .cp-drawer-price{white-space:nowrap;font-size:18px;font-weight:900}
  .cp-drawer-item-sub{display:block;margin-top:5px;color:#765943;font-size:12px;font-weight:700;line-height:1.35}
  .cp-drawer-value{display:flex;align-items:baseline;gap:8px;margin-top:9px}
  .cp-drawer-value s{color:#8d6f5c;font-size:12px}
  .cp-drawer-value strong{font-size:13px;color:#66704C}
  .cp-drawer-actions{display:flex;align-items:center;justify-content:space-between;margin-top:11px}
  .cp-drawer-actions button{border:0;background:transparent;padding:0;color:#3B1C06;font-size:12px;font-weight:900;text-decoration:underline;cursor:pointer}
  .cp-drawer-edit{margin-top:14px;padding:14px;border:1.5px solid #3B1C06;border-radius:14px;background:#FFFDF9}
  .cp-drawer-section-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
  .cp-drawer-section-head>strong{font:700 17px "Fredoka",sans-serif}
  .cp-drawer-section-head button{border:0;background:none;color:#765943;font-weight:800;cursor:pointer}
  .cp-drawer-bundle-list{display:grid;gap:8px}
  .cp-drawer-bundle-list>button{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;padding:11px 12px;border:1px solid #E8D8C3;border-radius:11px;background:#FFF6EA;color:#3B1C06;text-align:left;cursor:pointer}
  .cp-drawer-bundle-list>button.is-current{border:2px solid #FD7100;background:#FFF0E3}
  .cp-drawer-bundle-list span,.cp-drawer-bundle-list b,.cp-drawer-bundle-list small{display:block}
  .cp-drawer-bundle-list b{font-size:13px}
  .cp-drawer-bundle-list small{margin-top:2px;color:#765943;font-size:10px}
  .cp-drawer-bundle-list strong{font-size:15px}
  .cp-drawer-gifts{margin-top:18px;padding:15px;border:1.5px solid #3B1C06;border-radius:14px;background:#FFFDF9}
  .cp-drawer-gifts>strong{display:block;margin-bottom:9px;font:700 15px "Fredoka",sans-serif;letter-spacing:.06em}
  .cp-drawer-gift{display:flex;align-items:center;gap:8px;padding:6px 0;font-size:12px;font-weight:800}
  .cp-drawer-gift span:first-child{width:22px;height:22px;display:grid;place-items:center;flex:0 0 auto;border-radius:50%;background:#66704C;color:#fff;font-size:11px}
  .cp-drawer-gift.is-locked{color:#9a8b7f}
  .cp-drawer-gift.is-locked span:first-child{background:#E8D8C3;color:#765943}
  .cp-drawer-proof{display:grid;gap:7px;margin-top:18px;padding-top:16px;border-top:1px dashed #C8B49E;font-size:11px;font-weight:900}
  .cp-drawer-rating{font-weight:700}
  .cp-drawer-rating span{color:#FD7100;letter-spacing:1px}
  .cp-drawer-footer{padding:16px 20px calc(16px + env(safe-area-inset-bottom));background:#FFFDF9;border-top:1px solid #E8D8C3;box-shadow:0 -8px 22px rgba(59,28,6,.06)}
  .cp-drawer-total{display:flex;justify-content:space-between;align-items:center;margin-bottom:11px;font-size:16px}
  .cp-drawer-total strong{font-size:20px}
  .cp-drawer-checkout{display:flex;align-items:center;justify-content:center;min-height:54px;padding:13px 16px;border:1.5px solid #3B1C06;border-radius:13px;background:#FD7100;color:#fff;text-decoration:none;font-size:14px;font-weight:900;box-shadow:0 3px 0 rgba(59,28,6,.15)}
  .cp-drawer-footer>small{display:block;margin-top:8px;text-align:center;color:#765943;font-size:10px}
  @media(max-width:540px){.cp-drawer-header{padding:17px 16px 13px}.cp-drawer-header h2{font-size:26px}.cp-drawer-scroll{padding:15px 15px 20px}.cp-drawer-footer{padding:13px 15px calc(13px + env(safe-area-inset-bottom))}.cp-drawer-item{grid-template-columns:78px minmax(0,1fr);gap:11px}.cp-drawer-item img{width:78px;height:78px}.cp-drawer-item h3{font-size:16px}.cp-drawer-price{font-size:16px}}
  @media(prefers-reduced-motion:reduce){.cp-drawer-panel,.cp-drawer-overlay{transition:none}}
</style>

<script>
  (() => {
    const configElement = document.getElementById('cp-cart-config');
    const drawer = document.querySelector('cart-drawer.cp-cart-drawer');
    if (!configElement || !drawer) return;
    const config = JSON.parse(configElement.textContent);
    const rootPath = window.Shopify?.routes?.root || '/';
    const holdKey = 'cp_offer_hold_until';
    const lastOfferKey = 'cp_offer_last_variant';
    const lastQuantityKey = 'cp_offer_last_quantity';
    const expiredKey = 'cp_offer_expired';
    const duration = 300000;
    let currentCart = null;
    let timerInterval = null;
    let expiring = false;
    const loading = document.getElementById('cp-drawer-loading');
    const empty = document.getElementById('cp-drawer-empty');
    const expired = document.getElementById('cp-drawer-expired');
    const items = document.getElementById('cp-drawer-items');
    const edit = document.getElementById('cp-drawer-edit');
    const gifts = document.getElementById('cp-drawer-gifts');
    const giftList = document.getElementById('cp-drawer-gift-list');
    const proof = document.getElementById('cp-drawer-proof');
    const urgency = document.getElementById('cp-drawer-urgency');
    const footer = document.getElementById('cp-drawer-footer');
    const total = document.getElementById('cp-drawer-total');
    const timer = document.getElementById('cp-cart-timer');
    const endpoint = path => `${rootPath}${path}`;
    const offerIds = config.offers.map(offer => Number(offer.variantId));
    const money = cents => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 2 }).format(cents / 100);
    const escapeHtml = value => String(value || '').replace(/[&<>'"]/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[char]);
    const offerForSelection = (id, quantity) => config.offers.find(offer => Number(offer.variantId) === Number(id) && Number(offer.quantity) === Number(quantity));
    const bundleLines = cart => cart.items.filter(item => offerIds.includes(Number(item.variant_id)));
    async function getCart(){const response=await fetch(endpoint('cart.js'),{headers:{Accept:'application/json'}});if(!response.ok)throw new Error('Could not load cart.');return response.json()}
    function updateCartCount(count){document.querySelectorAll('.cp-nav-cart,.calmpet-nav-cart').forEach(link=>{let badge=link.querySelector('.cp-cart-count');if(count>0){if(!badge){badge=document.createElement('span');badge.className='cp-cart-count';link.appendChild(badge)}badge.textContent=count}else if(badge){badge.remove()}})}
    function giftMarkup(level){const rows=[{level:1,label:'Free U.S. Shipping'},{level:2,label:'$15 CalmPet Credit · valid 12 months'},{level:3,label:'Instant Trigger Stacking Field Guide'}];return rows.map(row=>`<div class="cp-drawer-gift${row.level>level?' is-locked':''}"><span>${row.level>level?'🔒':'✓'}</span><span>${row.label}</span></div>`).join('')}
    function otherItemMarkup(item){const image=item.image?`<img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.product_title)}">`:'';return `<article class="cp-drawer-item"><div>${image}</div><div><div class="cp-drawer-item-top"><h3>${escapeHtml(item.product_title)}</h3><span class="cp-drawer-price">${money(item.final_line_price)}</span></div><span class="cp-drawer-item-sub">Quantity: ${item.quantity}</span><div class="cp-drawer-actions"><span></span><button type="button" data-cp-action="remove-line" data-key="${escapeHtml(item.key)}">Remove</button></div></div></article>`}
    function render(cart){currentCart=cart;const bundles=bundleLines(cart);const bundle=bundles[0];const offer=bundle?offerForSelection(bundle.variant_id,bundle.quantity):null;const others=cart.items.filter(item=>!offerIds.includes(Number(item.variant_id)));loading.hidden=true;items.innerHTML='';updateCartCount(cart.item_count);total.textContent=money(cart.total_price);footer.hidden=cart.item_count===0;proof.hidden=!offer;gifts.hidden=!offer;urgency.hidden=!offer;edit.hidden=true;empty.hidden=cart.item_count!==0||localStorage.getItem(expiredKey)==='1';expired.hidden=localStorage.getItem(expiredKey)!=='1'||Boolean(offer);drawer.classList.toggle('is-empty',cart.item_count===0);if(offer){const image=config.image?`<img src="${escapeHtml(config.image)}" alt="CalmPet Collar">`:'';items.insertAdjacentHTML('beforeend',`<article class="cp-drawer-item cp-drawer-bundle"><div>${image}</div><div><div class="cp-drawer-item-top"><h3>${offer.name}</h3><span class="cp-drawer-price">${money(offer.price)}</span></div><span class="cp-drawer-item-sub">${offer.useCase}<br>${offer.perUnit}</span><div class="cp-drawer-value"><s>${money(offer.anchor)}</s><strong>${offer.saving}</strong></div><div class="cp-drawer-actions"><button type="button" data-cp-action="edit">Change bundle</button><button type="button" data-cp-action="remove-bundle">Remove</button></div></div></article>`);giftList.innerHTML=giftMarkup(offer.level);document.querySelectorAll('[data-cp-action="select-bundle"]').forEach(button=>button.classList.toggle('is-current',Number(button.dataset.variant)===Number(offer.variantId)&&Number(button.dataset.quantity)===Number(offer.quantity)));localStorage.setItem(lastOfferKey,String(offer.variantId));localStorage.setItem(lastQuantityKey,String(offer.quantity));localStorage.removeItem(expiredKey);ensureTimer()}else{stopTimer()}others.forEach(item=>items.insertAdjacentHTML('beforeend',otherItemMarkup(item)))}
    function startTimer(reset=false){let deadline=Number(localStorage.getItem(holdKey));if(reset||!deadline||deadline<=Date.now()){deadline=Date.now()+duration;localStorage.setItem(holdKey,String(deadline))}stopTimer(false);tick();timerInterval=window.setInterval(tick,1000)}
    function stopTimer(clear=false){if(timerInterval)window.clearInterval(timerInterval);timerInterval=null;if(clear)localStorage.removeItem(holdKey)}
    function ensureTimer(){const deadline=Number(localStorage.getItem(holdKey));if(!deadline){startTimer(true);return}if(deadline<=Date.now()){expireBundle();return}startTimer(false)}
    async function tick(){const deadline=Number(localStorage.getItem(holdKey));if(!deadline||!timer)return;const remaining=Math.max(0,Math.ceil((deadline-Date.now())/1000));const minutes=Math.floor(remaining/60);const seconds=remaining%60;timer.textContent=`${String(minutes).padStart(2,'0')}:${String(seconds).padStart(2,'0')}`;if(remaining===0&&!expiring)await expireBundle()}
    async function removeBundleLines(cart){const updates={};bundleLines(cart).forEach(item=>{updates[item.key]=0});if(!Object.keys(updates).length)return cart;const response=await fetch(endpoint('cart/update.js'),{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({updates})});if(!response.ok)throw new Error('Could not update cart.');return response.json()}
    async function expireBundle(){expiring=true;try{const cart=currentCart||await getCart();localStorage.setItem(expiredKey,'1');stopTimer(true);render(await removeBundleLines(cart))}finally{expiring=false}}
    async function setBundle(variantId,quantity,trigger,resetTimer=false){loading.hidden=false;const offer=offerForSelection(variantId,quantity);if(!offer)throw new Error('Unknown bundle.');let cart=await getCart();cart=await removeBundleLines(cart);const response=await fetch(endpoint('cart/add.js'),{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({items:[{id:Number(variantId),quantity:Number(quantity),properties:{'Bundle':`${quantity} CalmPet Collars`,'Purchase type':'One-time purchase · No subscription'}}]})});if(!response.ok)throw new Error('Could not add bundle.');localStorage.setItem(lastOfferKey,String(variantId));localStorage.setItem(lastQuantityKey,String(quantity));localStorage.removeItem(expiredKey);startTimer(resetTimer||!Number(localStorage.getItem(holdKey)));render(await getCart());if(typeof drawer.open==='function')drawer.open(trigger);return currentCart}
    async function removeLine(key){const response=await fetch(endpoint('cart/change.js'),{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({id:key,quantity:0})});if(!response.ok)throw new Error('Could not remove item.');return response.json()}
    drawer.addEventListener('click',async event=>{if(event.target===document.getElementById('CartDrawer-Overlay')){drawer.close();return}const button=event.target.closest('[data-cp-action]');if(!button)return;const action=button.dataset.cpAction;button.disabled=true;try{if(action==='edit')edit.hidden=false;if(action==='close-edit')edit.hidden=true;if(action==='select-bundle')await setBundle(Number(button.dataset.variant),Number(button.dataset.quantity),button);if(action==='remove-bundle'){stopTimer(true);localStorage.removeItem(expiredKey);render(await removeBundleLines(currentCart||await getCart()))}if(action==='remove-line')render(await removeLine(button.dataset.key));if(action==='restore'){const variantId=Number(localStorage.getItem(lastOfferKey))||Number(config.offers[1].variantId);const quantity=Number(localStorage.getItem(lastQuantityKey))||Number(config.offers[1].quantity);const offer=offerForSelection(variantId,quantity)||config.offers[1];await setBundle(offer.variantId,offer.quantity,button,true)}}catch(error){loading.textContent='Could not update your cart. Please try again.';loading.hidden=false}finally{button.disabled=false}})
    document.addEventListener('click',event=>{if(event.target.closest('.cp-nav-cart,.calmpet-nav-cart'))refresh()})
    async function refresh(){try{render(await getCart())}catch(error){loading.textContent='Could not load your cart. Please refresh the page.'}}
    window.addEventListener('storage',event=>{if(event.key===holdKey)tick()})
    window.cpCalmPetCart={setBundle,refresh};refresh()
  })();
</script>
